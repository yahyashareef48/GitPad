{
  "name": "gitpad",
  "displayName": "GitPad",
  "description": "A Git-powered workspace for notes, to-do lists, and flowcharts — all inside VS Code.",
  "version": "0.0.1",
  "publisher": "YahyaShareef",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "git",
    "notes",
    "todo",
    "flowchart",
    "github"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yahyashareef48/GitPad.git"
  },
  "bugs": {
    "url": "https://github.com/yahyashareef48/GitPad/issues"
  },
  "homepage": "https://github.com/yahyashareef48/GitPad#readme",
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gitpad",
          "title": "GitPad",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "gitpad": [
        {
          "id": "gitpad.sidebar",
          "name": "Notes",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs --production",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc -p ./ && tsc -p ./webview",
    "lint": "eslint .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.x",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.x",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "typescript": "^5.x",
    "typescript-eslint": "^8.65.0"
  }
}
