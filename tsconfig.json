{
  // Typechecking only — esbuild does the emitting (see esbuild.mjs).
  // This config covers the extension host side: Node APIs, no DOM.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    // Explicitly Node-only. Without this, DOM globals leak in from other
    // @types packages and code that could never run in the extension host
    // still typechecks.
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "sourceMap": true
  },
  "include": ["src"]
}
